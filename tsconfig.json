{
  // Type-checks the JSDoc-typed JavaScript; nothing is emitted (ADR-0001).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["tgcloud", "tests", "scripts", "types", "vitest.config.js"]
}
