{
  // Type-checks the JSDoc-typed JavaScript; nothing is emitted (ADR-0001).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    // scripts/tgcloud/ holds modules the operator copies into tgcloud/ for one run (the
    // legacy import); their relative imports resolve as if they already sat there.
    "rootDirs": ["tgcloud", "scripts/tgcloud"]
  },
  "include": ["tgcloud", "tests", "scripts", "types", "vitest.config.js"]
}
