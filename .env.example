# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=

# Telegram user id of the single admin (required)
ADMIN_ID=

# Path to the SQLite database file (optional, default: ./db/audio_meme.db)
# DB_PATH=./db/audio_meme.db

# Require admin approval before a user can send memes via inline mode (optional,
# default: false). When true, unapproved users see a "wait for approval" message
# and the admin approves them with /users. When false, anyone may use the bot.
# Use the literal value true or false.
# REQUIRE_APPROVAL=false

# Custom Telegram Bot API endpoint, e.g. a self-hosted Bot API server (optional).
# When set, telebot.apihelper.API_URL is overridden to bypass restrictions.
# TG_API_URL=https://api.telegram.org
# TG_API_TIMEOUT=25