# Local config for `npm run config`, which writes tgcloud/lib/config.js. In CI the same
# keys come from the deploying bot instance's GitHub Environment (README "Bot instances").
# For `npm run restore`, copy this to one gitignored file per bot instance, e.g.
# .env.prod-privatebot, with that bot's TGCLOUD_TOKEN (required there) and ADMIN_ID.

# Telegram user id of the single admin (required)
ADMIN_ID=

# Require admin approval before a user can send memes via inline mode (optional,
# default: false). When true, unapproved users see a "wait for approval" message
# and the admin approves them with /users. Use the literal value true or false.
# REQUIRE_APPROVAL=false

# The bot instance's tgcloud token, app<id>:<secret> (optional). When set, /add offers
# the Converter, served at https://app<id>.tgcloud.ai/; only that URL goes into the
# config, never the secret. `npm run config` doesn't export it to your shell: the tgcloud
# CLI uses `tgcloud login` unless TGCLOUD_TOKEN is set in the environment.
# TGCLOUD_TOKEN=
