# Local config (one env file per bot instance for `npm run restore`) and CLI state
.env
.env.*
!.env.example
.tgcloud/
tgcloud/lib/config.js

# Never-deployed operator endpoints, copied in by `npm run restore` for one run
tgcloud/endpoints/restore.js
tgcloud/endpoints/clear_library.js

# Dependencies, build and coverage output
node_modules/
dist/
coverage/

# Bot data: a Python bot instance's SQLite database and exported or downloaded backups
*.db
/db/
backup*.json

# Editors and OS
.DS_Store
.idea/
.vscode/
